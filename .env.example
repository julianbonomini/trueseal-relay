# ── Required ──────────────────────────────────────────────────────────────────
# Subdomain for the relay health endpoint (e.g. relay.yourdomain.com)
RELAY_DOMAIN=relay.yourdomain.com

# Subdomain for the public log viewer — Dozzle (e.g. logs.yourdomain.com)
LOGS_DOMAIN=logs.yourdomain.com

# Health upstream for Caddy — relay:7702 (single node) or lb:7702 (cluster)
HEALTH_UPSTREAM=relay:7702

# ── Docker image ──────────────────────────────────────────────────────────────
# Updated automatically by the deploy pipeline on each release tag.
# Override here to pin to a specific version.
RELAY_IMAGE=ghcr.io/julianbonomini/trueseal-relay:latest

# ── Keypair (optional) ────────────────────────────────────────────────────────
# By default, a keypair is auto-generated on first run and stored in the
# relay-data Docker volume at /data/keypair.hex.
#
# To bring your own keypair (e.g. to restore a known public key after
# redeployment), set the hex-encoded X25519 private key here.
# Generate one with: docker compose run --rm relay /trueseal-relay -genkey
#
# TRUESEAL_RELAY_KEYPAIR_HEX=your_hex_encoded_private_key_here

# ── Optional overrides ────────────────────────────────────────────────────────
# All values below have sensible defaults. Uncomment to override.
#
# TRUESEAL_RELAY_TTL=720h
# TRUESEAL_RELAY_REAP_INTERVAL=1h
# TRUESEAL_RELAY_MAX_CONNECTIONS=1000
